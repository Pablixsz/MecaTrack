# MecaTrack - environment for docker compose (copy to .env; .env is git-ignored).
# ./scripts/dev.sh up creates .env from this file and fills the secrets with random values.
# Generate a secret by hand with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- PostgreSQL (db service) ---
POSTGRES_USER=mecatrack
# URL-safe characters only (letters, digits, - _ .): it goes inside DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=taller_mecanico
# Host port of the database (5433 avoids clashing with a local PostgreSQL)
DB_HOST_PORT=5433

# --- App ---
APP_PORT=8000
FLASK_ENV=production
# Flask secret (required)
SECRET_KEY=
# JWT signing key (required, at least 32 characters)
JWT_SECRET_KEY=

# --- Optional: AI assistant (without a key /api/v1/ai answers 503) ---
GEMINI_API_KEY=
GEMINI_MODEL=
